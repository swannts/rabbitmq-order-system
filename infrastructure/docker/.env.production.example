# Copy to .env.production and supply values from your deployment secret store.
# Use immutable image tags (ideally digests), never :latest.
ORDER_SERVICE_IMAGE=registry.example.com/order-service:1.0.0
PAYMENT_SERVICE_IMAGE=registry.example.com/payment-service:1.0.0
INVENTORY_SERVICE_IMAGE=registry.example.com/inventory-service:1.0.0
ORDER_HISTORY_SERVICE_IMAGE=registry.example.com/order-history-service:1.0.0

# Managed PostgreSQL endpoint for orders.
ORDER_DATABASE_URL=jdbc:postgresql://orders-db.example.com:5432/orders
ORDER_DATABASE_USER=orders_app
ORDER_DATABASE_PASSWORD=replace-me

# Managed MySQL endpoint for payments.
PAYMENT_APP_KEY=base64:replace-with-generated-application-key
PAYMENT_DATABASE_HOST=payments-db.example.com
PAYMENT_DATABASE_PORT=3306
PAYMENT_DATABASE_NAME=payments
PAYMENT_DATABASE_USER=payments_app
PAYMENT_DATABASE_PASSWORD=replace-me

# Managed MongoDB endpoint for inventory.
INVENTORY_MONGODB_URI=mongodb+srv://inventory_app:replace-me@inventory.example.com/inventory?retryWrites=true&w=majority

# Managed ClickHouse HTTPS endpoint for event history and analytics.
HISTORY_CLICKHOUSE_URL=https://history-db.example.com:8443
HISTORY_CLICKHOUSE_USER=history_app
HISTORY_CLICKHOUSE_PASSWORD=replace-me

# Managed RabbitMQ and Kafka endpoints using TLS/SASL TLS.
RABBITMQ_HOST=rabbitmq.example.com
RABBITMQ_PORT=5671
RABBITMQ_USERNAME=order-platform
RABBITMQ_PASSWORD=replace-me
RABBITMQ_URL=amqps://order-platform:replace-me@rabbitmq.example.com:5671
KAFKA_BOOTSTRAP_SERVERS=kafka-1.example.com:9094,kafka-2.example.com:9094
KAFKA_ORDER_SASL_USERNAME=order-service
KAFKA_ORDER_SASL_PASSWORD=replace-me
KAFKA_HISTORY_SASL_USERNAME=order-history
KAFKA_HISTORY_SASL_PASSWORD=replace-me
